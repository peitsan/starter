# pnpm-friendly config (also read by pnpm itself)
engine-strict=true
fund=false
audit-level=moderate
save-exact=true
prefer-frozen-lockfile=false

# pnpm-side knobs
# - prefer offline when CI cache is warm
prefer-offline=false
# - hoist nothing to root by default (strict isolation, smaller dep graph)
shamefully-hoist=false
strict-peer-dependencies=false
auto-install-peers=true
# - allow scripts in known-safe packages
# (pnpm 9 requires explicit allow-list; we list nothing by default to be safe)
# allow-build = []
