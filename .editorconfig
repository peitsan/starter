# EditorConfig — https://EditorConfig.org
# 顶级项目统一风格；与 .prettierrc 配合，冲突时以 Prettier 为准。

root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 100

[*.md]
trim_trailing_whitespace = false   # 末尾两个空格 = MD 换行
max_line_length = off

[*.{yml,yaml}]
indent_size = 2

[*.{ts,tsx,js,jsx,mjs,cjs}]
quote_type = single

[Makefile]
indent_style = tab
