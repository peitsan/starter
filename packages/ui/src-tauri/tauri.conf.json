{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Starter",
  "version": "0.2.0",
  "identifier": "com.peitsan.starter",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Starter",
        "label": "main",
        "width": 980,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "Starter — startup manager"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "publisher": "peitsan",
    "shortDescription": "Modern Windows startup manager",
    "longDescription": "Starter — IO-aware Windows startup manager with CLI and MCP server.",
    "windows": {
      "wix": {
        "language": ["en-US", "zh-CN"]
      },
      "nsis": {
        "languages": ["English", "SimpChinese"]
      }
    }
  }
}
